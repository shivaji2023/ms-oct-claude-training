<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Technizer.TaskApi</RootNamespace>
    <AssemblyName>TaskApi</AssemblyName>
    <Version>0.1.0</Version>
    <Description>Task Management API - Claude Code training demo backend (.NET port)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TaskApi.Tests" />
  </ItemGroup>

</Project>
